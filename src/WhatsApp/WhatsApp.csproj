<Project Sdk="Microsoft.NET.Sdk"> 

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Devlooped.WhatsApp</AssemblyName>
    <Description>WhatsApp agents for .NET</Description>
    <PackageId>Devlooped.WhatsApp</PackageId>
    <PackContent>false</PackContent>
    <LangVersion>Preview</LangVersion>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>OSMFEULA.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>dotnet csharp whatsapp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Abstractions" Version="2.3.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />

    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageReference Include="Devlooped.JQSharp" Version="1.0.1" />
    <PackageReference Include="Devlooped.TableStorage" Version="5.5.0" />

    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.80.0" />

    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NuGetizer" Version="1.5.0" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="ThisAssembly.AssemblyInfo" Version="2.1.2" PrivateAssets="all" />
    <PackageReference Include="ThisAssembly.Resources" Version="2.1.2" PrivateAssets="all" />
    <PackageReference Include="Ulid " Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeAnalysis\CodeAnalysis.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Devlooped.WhatsApp.Tests" />
    <InternalsVisibleTo Include="Devlooped.WhatsApp.Functions" />
    <InternalsVisibleTo Include="Devlooped.WhatsApp.AspNetCore" />
    <EmbeddedResource Include="Message.jq" Kind="Text" />
    <EmbeddedResource Include="Flows\FlowJsonSchema.json" Kind="Text" />
    <EmbeddedResource Include="Flows\FlowJsonRules.json" Kind="Text" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\osmfeula.txt" Link="osmfeula.txt" PackagePath="OSMFEULA.txt" />
  </ItemGroup>

</Project>
