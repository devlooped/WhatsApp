{
  "version": "2.0",
  "extensions": {
    "http": {
      "routePrefix": ""
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    },
    "logLevel": {
      "default": "Warning",
      "Function": "Trace",
      "Azure": "Warning",
      "Azure.Core": "Error",
      "Microsoft": "Warning",
      "System": "Warning",
      "Devlooped.WhatsApp": "Debug"
    }
  }
}